<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Account_number_validation</fullName>
    <active>true</active>
    <description>Account number should be as below format.
0000-000-0000-0</description>
    <errorConditionFormula>NOT(REGEX( Account_Number__c , &quot;[0-9a-zA-Z]{4}-[0-9a-zA-Z]{3}-[0-9a-zA-Z]{4}-[0-9a-zA-Z]{1}&quot;))
 &amp;&amp;  
ISPICKVAL( Country_Name__c , &apos;Dubai&apos;)</errorConditionFormula>
    <errorMessage>Account number should be as below format.
0000-000-0000-0</errorMessage>
</ValidationRule>
