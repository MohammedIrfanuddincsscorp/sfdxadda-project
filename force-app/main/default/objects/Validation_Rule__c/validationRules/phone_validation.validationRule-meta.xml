<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>phone_validation</fullName>
    <active>true</active>
    <errorConditionFormula>REGEX( phone__c , &quot;[+0-9]{2}-[0-9]{10}&quot;)</errorConditionFormula>
    <errorMessage>mention correct phone number</errorMessage>
</ValidationRule>
