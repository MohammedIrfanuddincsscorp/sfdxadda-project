<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validation_for_Age</fullName>
    <active>true</active>
    <errorConditionFormula>Age__c &lt;18  ||  Age__c &gt;40</errorConditionFormula>
    <errorDisplayField>Age__c</errorDisplayField>
    <errorMessage>Age should not be below 18 and should not be above 40</errorMessage>
</ValidationRule>
